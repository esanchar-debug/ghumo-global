{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.mjs": {
      "includeFiles": "server/**",
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ghumoglobal.in"
        }
      ],
      "destination": "https://ghumoglobal.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ghumoglobal.in"
        }
      ],
      "destination": "https://ghumoglobal.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/destinations/:path*",
      "destination": "/api/destinations/[...path]"
    },
    {
      "source": "/api/stories/:path*",
      "destination": "/api/stories/[...path]"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin/[...path]"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
